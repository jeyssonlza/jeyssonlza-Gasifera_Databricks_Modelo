{
  "datasets": [
    {
      "name": "agepar",
      "displayName": "KPIs AGEPAR",
      "config": {
        "version": "1.1",
        "source": "workspace.gasifera_gold.gold_kpis_agepar_largo",
        "dimensions": [
          {
            "name": "periodo",
            "expr": "periodo"
          },
          {
            "name": "region",
            "expr": "region"
          },
          {
            "name": "indicador",
            "expr": "indicador"
          }
        ],
        "measures": [
          {
            "name": "Valor",
            "expr": "SUM(valor)"
          },
          {
            "name": "Meta",
            "expr": "SUM(meta)"
          },
          {
            "name": "Cumplimiento",
            "expr": "AVG(CAST(cumple_meta AS DOUBLE))"
          }
        ]
      }
    },
    {
      "name": "agepar_ultimo",
      "displayName": "KPIs último mes",
      "queryLines": [
        "SELECT periodo, region, indicador, valor, meta, sentido, cumple_meta\n",
        "FROM (SELECT *, RANK() OVER (ORDER BY periodo DESC) AS rk FROM workspace.gasifera_gold.gold_kpis_agepar_largo)\n",
        "WHERE rk = 1"
      ]
    }
  ],
  "pages": [
    {
      "name": "regulatorio",
      "displayName": "KPIs Regulatorios AGEPAR",
      "layout": [
        {
          "widget": {
            "name": "cumplimiento_global",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "agepar",
                  "fields": [
                    {
                      "name": "cumplimiento",
                      "expression": "MEASURE(`Cumplimiento`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "title": "Cumplimiento global de metas",
                "showTitle": true
              },
              "encodings": {
                "value": {
                  "fieldName": "cumplimiento",
                  "displayName": "Cumplimiento",
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "cumplimiento_mensual",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "agepar",
                  "fields": [
                    {
                      "name": "periodo",
                      "expression": "`periodo`"
                    },
                    {
                      "name": "cumplimiento",
                      "expression": "MEASURE(`Cumplimiento`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "frame": {
                "title": "Cumplimiento de metas por mes (%)",
                "showTitle": true
              },
              "encodings": {
                "x": {
                  "fieldName": "periodo",
                  "displayName": "Mes",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "cumplimiento",
                  "displayName": "Cumplimiento",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "data": {
                "queryName": "main"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 2,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "cumplimiento_indicador",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "agepar",
                  "fields": [
                    {
                      "name": "indicador",
                      "expression": "`indicador`"
                    },
                    {
                      "name": "cumplimiento",
                      "expression": "MEASURE(`Cumplimiento`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "frame": {
                "title": "Cumplimiento por indicador (%)",
                "showTitle": true
              },
              "encodings": {
                "y": {
                  "fieldName": "indicador",
                  "displayName": "Indicador",
                  "scale": {
                    "type": "categorical",
                    "categorySize": {
                      "type": "number-of-categories",
                      "number": 7
                    },
                    "sort": {
                      "by": "measure-reversed",
                      "measure": {
                        "fieldName": "cumplimiento"
                      }
                    }
                  }
                },
                "x": {
                  "fieldName": "cumplimiento",
                  "displayName": "Cumplimiento",
                  "scale": {
                    "type": "quantitative"
                  }
                }
              },
              "data": {
                "queryName": "main"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 8,
            "width": 6,
            "height": 7
          }
        },
        {
