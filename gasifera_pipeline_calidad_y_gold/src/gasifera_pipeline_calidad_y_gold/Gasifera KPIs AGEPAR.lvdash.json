                    {
                      "name": "measure(Cumplimiento)",
                      "expression": "MEASURE(`Cumplimiento`)"
                    }
                  ],
                  "disaggregated": false,
                  "orders": [
                    {
                      "direction": "DESC",
                      "expression": "MEASURE(`Cumplimiento`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
