{
  "datasets": [
    {
      "name": "gastos",
      "displayName": "Gastos CAPEX/OPEX",
      "config": {
        "version": "1.1",
        "source": "workspace.gasifera_gold.gold_finanzas_mensual",
        "dimensions": [
          {
            "name": "periodo",
            "expr": "periodo"
          },
          {
            "name": "tipo_gasto",
            "expr": "tipo_gasto"
          }
        ],
        "measures": [
          {
            "name": "Plan USD",
            "expr": "SUM(plan_usd)"
          },
          {
            "name": "Real USD",
            "expr": "SUM(real_usd)"
          },
          {
            "name": "Ejecucion",
            "expr": "MEASURE(`Real USD`) / MEASURE(`Plan USD`)"
          }
        ]
      }
    },
    {
      "name": "ingresos",
      "displayName": "Ingresos por consumo",
      "config": {
        "version": "1.1",
        "source": "workspace.gasifera_gold.gold_consumo_mensual",
        "dimensions": [
          {
            "name": "periodo",
            "expr": "periodo"
          },
          {
            "name": "region",
            "expr": "region"
          },
          {
            "name": "tipo_cliente",
            "expr": "tipo_cliente"
          }
        ],
        "measures": [
          {
            "name": "Facturacion USD",
            "expr": "SUM(facturacion_usd)"
          },
          {
            "name": "Impago pct",
            "expr": "AVG(pct_impago)"
          },
          {
            "name": "Clientes",
            "expr": "SUM(clientes)"
          }
        ]
      }
    },
    {
      "name": "gastos_ultimo",
      "displayName": "Gastos último mes",
      "queryLines": [
        "SELECT periodo, tipo_gasto, plan_usd, real_usd, desvio_pct\n",
        "FROM (SELECT *, RANK() OVER (ORDER BY periodo DESC) AS rk FROM workspace.gasifera_gold.gold_finanzas_mensual)\n",
        "WHERE rk = 1"
      ]
    }
  ],
  "pages": [
    {
      "name": "finanzas",
      "displayName": "Finanzas",
      "layout": [
        {
          "widget": {
            "name": "ejecucion_capex",
            "queries": [
              {
                "name": "main",
                "query": {
                  "datasetName": "gastos",
                  "fields": [
                    {
                      "name": "ejecucion",
                      "expression": "MEASURE(`Ejecucion`)"
                    }
                  ],
                  "filters": [
                    {
                      "expression": "`tipo_gasto` IN ('capex')"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "title": "Ejecución CAPEX (real/plan, acumulado)",
                "showTitle": true
              },
              "encodings": {
                "value": {
                  "fieldName": "ejecucion",
                  "displayName": "Ejecución",
                  "format": {
                    "type": "number-percent",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "facturacion_total",
