              {
                "name": "main",
                "query": {
                  "datasetName": "ingresos",
                  "fields": [
                    {
                      "name": "fact_M",
                      "expression": "MEASURE(`Facturacion USD`) / 1000000"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "title": "Facturación acumulada 35 meses (M USD)",
                "showTitle": true
              },
              "encodings": {
                "value": {
                  "fieldName": "fact_M",
                  "displayName": "M USD",
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 1
                    }
                  }
                }
              },
              "data": {
                "queryName": "main"
